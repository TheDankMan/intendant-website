---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';
import CatalogueScreen from '../components/product/CatalogueScreen.astro';
import SafetyFormMock from '../components/product/SafetyFormMock.astro';
import DashboardMock from '../components/product/DashboardMock.astro';

const products = [
  {
    href: '/ordering',
    name: 'Ordering',
    body: 'Procurement for teams that buy from several suppliers. Order by job, capture proof of delivery, match invoices, push to Xero.',
    fits: 'Contractors, FM and multi-site operators',
    shot: 'ordering',
  },
  {
    href: '/site-safety',
    name: 'Site Safety',
    body: 'HSQE forms, inspections, drawings and registers on a tablet. Built to keep working offline.',
    fits: 'Construction and civils site teams',
    shot: 'safety',
  },
  {
    href: '/dashboards',
    name: 'Dashboards',
    body: 'Branded client dashboards and monthly packs for accountancy firms, built from Xero exports.',
    fits: 'Accountancy and bookkeeping firms',
    shot: 'dash',
  },
];

const work = [
  {
    who: 'UK building contractor',
    title: 'Ordering and site safety, across every live job',
    body: 'Weekly procurement across several suppliers and site managers, plus the HSQE forms, inspections and drawings that run alongside it.',
  },
  {
    who: 'Accountancy firm',
    title: 'Client dashboards from Xero exports',
    body: 'Replacing a hand-maintained monthly report with branded dashboards that each client logs in to, with commentary the firm approves.',
  },
  {
    who: 'HR and staffing business',
    title: 'Timesheets, approvals and billing',
    body: 'A custom timesheet platform, from client approvals through to invoicing, currently at prototype stage.',
  },
];
---

<BaseLayout title="Intendant — operations software for businesses that run on site">
  <section class="hero">
    <div class="container" style="max-width:960px; padding-top:88px; padding-bottom:96px; position:relative;">
      <div class="eyebrow accent">Intendant · Operations software</div>
      <h1>
        Software for the work<br />
        <span class="accent">spreadsheets can't hold.</span>
      </h1>
      <p class="lede light" style="max-width:62ch;">
        We build operations software for businesses whose work happens on site and in the field: ordering, site safety and client reporting, as ready-made products or built around how you work.
      </p>
      <div style="display:flex; gap:12px; margin-top:28px; flex-wrap:wrap;">
        <a class="btn btn-primary" href="#products">See the products</a>
        <a class="btn btn-ghost" href="/custom-software">Need something custom? →</a>
      </div>
    </div>
  </section>

  <section class="section" id="products">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow accent">Products</span>
        <h2>Three products, each built for a real client.</h2>
        <p class="lede">Each one started as a problem a client brought us, and was built to be used by others too.</p>
      </div>
      <div class="product-cards">
        {products.map((p) => (
          <a class="product-card" href={p.href}>
            <div class="pc-shot" aria-hidden="true">
              {p.shot === 'ordering' && <CatalogueScreen height={360} />}
              {p.shot === 'safety' && <SafetyFormMock height={360} />}
              {p.shot === 'dash' && <DashboardMock height={360} />}
            </div>
            <div class="pc-body">
              <div class="eyebrow accent">Intendant</div>
              <h3>{p.name}</h3>
              <p>{p.body}</p>
              <div class="pc-for">For: {p.fits}</div>
              <span class="pc-link">Explore {p.name} →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-canvas">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Recent work</span>
        <h2>What we've built, and for whom.</h2>
        <p class="lede">Clients aren't named here. Ask us, and we'll tell you more on a call.</p>
      </div>
      <div class="work-grid">
        {work.map((w) => (
          <div class="work-card">
            <div class="who">{w.who}</div>
            <h4>{w.title}</h4>
            <p>{w.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container" style="display:grid; grid-template-columns:repeat(auto-fit, minmax(260px, 1fr)); gap:40px; align-items:start;">
      <div>
        <span class="eyebrow accent">Custom software</span>
        <h2 style="font-family:var(--font-display); font-weight:700; font-size:clamp(32px, 4vw, 44px); text-transform:uppercase; color:var(--mw-500); line-height:1; margin:12px 0 16px;">Doesn't fit a product? We'll build it.</h2>
        <p class="lede">We start from the same proven parts as our products and shape them to your process: prototype first, then build in stages.</p>
        <a class="btn btn-secondary" href="/custom-software" style="margin-top:20px;">How we work</a>
      </div>
      <ul style="list-style:none; padding:0; margin:0; display:grid; gap:12px;">
        <li class="card-flat" style="padding:18px 20px;"><strong>Orders &amp; approvals</strong><br /><span style="color:var(--text-secondary); font-size:14px;">POs, approval chains, supplier records</span></li>
        <li class="card-flat" style="padding:18px 20px;"><strong>Forms &amp; evidence</strong><br /><span style="color:var(--text-secondary); font-size:14px;">Offline forms, photos, signatures, sealed PDFs</span></li>
        <li class="card-flat" style="padding:18px 20px;"><strong>Time &amp; people</strong><br /><span style="color:var(--text-secondary); font-size:14px;">Timesheets, approvals, rates</span></li>
        <li class="card-flat" style="padding:18px 20px;"><strong>Reporting</strong><br /><span style="color:var(--text-secondary); font-size:14px;">Dashboards, packs, Xero data</span></li>
      </ul>
    </div>
  </section>

  <CtaBand
    heading="Tell us what you're trying to fix."
    sub="A short call about how your team works today. If one of our products fits, we'll show you. If not, we'll say so."
    primaryLabel="Get in touch"
    secondaryHref="#products"
    secondaryLabel="See the products"
  />
</BaseLayout>
